{
  "model": "openai/gpt-6-astra",
  "agent": {
    "build": {
      "model": "openai/gpt-6-astra",
      "variant": "high"
    }
  },
  "share": "disabled",
  "autoupdate": true,
  "lsp": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"]
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"]
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      }
    }
  }
}
